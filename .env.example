# Aarogya Care — Environment Variables
# Copy this file to .env and fill in your values.

# ─── Gemini AI (Required for Symptom Checker) ───────────────────────────────
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ─── Supabase (Required for real auth + database) ────────────────────────────
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
VITE_SUPABASE_URL="YOUR_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# ─── Razorpay (Optional — demo payment UI works without these) ───────────────
# Get test keys from: https://dashboard.razorpay.com/app/keys
VITE_RAZORPAY_KEY_ID="YOUR_RAZORPAY_KEY_ID"

# ─── App URL (Auto-injected by AI Studio in production) ──────────────────────
APP_URL="http://localhost:3000"
