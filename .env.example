# MediNest Environment Variables Example
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND (Vercel) — prefix ALL Vite variables with VITE_
# ─────────────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL="https://your-backend-name.onrender.com/api/v1"
VITE_CLERK_PUBLISHABLE_KEY="pk_live_xxxxxxxxxxxxxxxxxxxxx"
VITE_RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxx"

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND (Render) — server-side only, never exposed to browser
# ─────────────────────────────────────────────────────────────────────────────
PORT=10000
NODE_ENV=production

# Clerk (server-side secret)
CLERK_SECRET_KEY="sk_live_xxxxxxxxxxxxxxxxxxxxx"

# Razorpay (server-side secret)
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxx"

# Gemini AI
GEMINI_API_KEY="AIzaSy_xxxxxxxxxxxxxxxxxxxxx"

# MySQL (use Aiven / PlanetScale / Railway connection string values)
MYSQL_HOST="your-mysql-host.aivencloud.com"
MYSQL_PORT=3306
MYSQL_USER="your_mysql_user"
MYSQL_PASSWORD="your_mysql_password"
MYSQL_DATABASE="medinest_db"

# MongoDB Atlas (use the Atlas connection string)
MONGODB_URI="mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/medinest?retryWrites=true&w=majority"

# App URLs (CORS)
APP_URL="https://your-project.vercel.app"
FRONTEND_URL="https://your-custom-domain.com"

# Admin secret
ADMIN_SECRET_KEY="your_very_long_random_admin_secret"